# Copy this file to .env and fill in your keys.

# AI for answers. Use ONE of these (if both are set, Claude is used):
# FREE: Google Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# PAID, best quality: Claude key from https://platform.claude.com
ANTHROPIC_API_KEY=

# Stripe (https://dashboard.stripe.com/test/apikeys); without these, upgrades run in demo mode
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Firebase (accounts + database). Paste the WHOLE service account JSON on one line. KEEP SECRET.
# Firebase console > Project settings > Service accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT=

# Your public site address once deployed, e.g. https://atma.onrender.com
APP_URL=http://localhost:3000
FREE_QUESTIONS_PER_DAY=3
